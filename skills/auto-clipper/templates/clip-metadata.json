{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clip Metadata",
  "type": "object",
  "properties": {
    "clipId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "Catchy title for social media"
    },
    "description": {
      "type": "string",
      "maxLength": 300,
      "description": "Engaging description with CTA"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10,
      "description": "SEO keywords"
    },
    "hashtags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^#" },
      "maxItems": 10,
      "description": "Platform hashtags"
    },
    "category": {
      "type": "string",
      "enum": ["entertainment", "education", "lifestyle", "tech", "gaming", "business", "health", "finance", "comedy", "news"]
    },
    "viralScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall viral potential score"
    },
    "viralFactors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number" },
          "value": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string" }
        },
        "required": ["name", "weight", "value", "description"]
      }
    },
    "engagementPrediction": {
      "type": "object",
      "properties": {
        "views": { "type": "integer", "minimum": 0 },
        "likes": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "shares": { "type": "integer", "minimum": 0 },
        "retentionRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["views", "likes", "comments", "shares", "retentionRate"]
    },
    "thumbnailPath": {
      "type": "string",
      "description": "Path to generated thumbnail"
    },
    "platformOptimizations": {
      "type": "object",
      "properties": {
        "tiktok": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "hashtags": { "type": "array", "items": { "type": "string" } },
            "trendingAudio": { "type": "boolean" }
          }
        },
        "reels": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "hashtags": { "type": "array", "items": { "type": "string" } },
            "coverFrame": { "type": "number" }
          }
        },
        "shorts": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "hashtags": { "type": "array", "items": { "type": "string" } },
            "seoKeywords": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "enum": ["openai", "anthropic", "google", "template"] },
    "model": { "type": "string" }
  },
  "required": ["clipId", "title", "description", "tags", "hashtags", "category", "viralScore", "engagementPrediction"]
}