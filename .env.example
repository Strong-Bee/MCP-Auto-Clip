# MCP Auto Clipper - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# Database
DATABASE_PATH=./data/autoclipper.sqlite

# FFmpeg (optional - will use ffmpeg-static if not set)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# AI Providers - At least one required
# OpenAI
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-1.5-pro

# NVIDIA
NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=parakeet-tdt-1.1b

# Redis (for job queue - optional)
# REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Storage paths
STORAGE_PATH=./storage
TEMP_PATH=./temp
OUTPUT_PATH=./output

# Video Processing
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_TARGET_DURATION=60
MAX_CLIPS_PER_JOB=10
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=120
VIDEO_BITRATE=2M
AUDIO_BITRATE=128k
FPS=30

# Subtitle
SUBTITLE_FONT_FAMILY=Arial
SUBTITLE_FONT_SIZE=24
SUBTITLE_FONT_COLOR=#FFFFFF
SUBTITLE_OUTLINE_COLOR=#000000
SUBTITLE_OUTLINE_WIDTH=2
SUBTITLE_POSITION=bottom
SUBTITLE_MARGIN=50

# Quality
QUALITY_THRESHOLD=0.7
ENABLE_VIRAL_SCORING=true
MAX_RETRY_ATTEMPTS=2

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Security
ALLOWED_PATHS=./storage,./temp,./output
MAX_FILE_SIZE=524288000
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm,.flv
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.aac,.m4a,.ogg,.flac

# MCP
MCP_SERVER_NAME=auto-clipper
MCP_SERVER_VERSION=1.0.0